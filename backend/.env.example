# Modele de configuration locale. Copiez ce fichier en `.env` et renseignez
# vos valeurs. Le fichier `.env` est exclu du depot par .gitignore.

# Cle API Groq (https://console.groq.com).
# Laissez vide pour desactiver le LLM : l'assistant bascule automatiquement sur
# son moteur a regles, qui fonctionne hors ligne et sans compte.
GROQ_API_KEY=
GROQ_MODELE=llama-3.3-70b-versatile
GROQ_TIMEOUT=6
