        <mxCell id="n105" value="&amp;laquo;extend&amp;raquo; et non &amp;laquo;include&amp;raquo;&lt;br&gt;&lt;br&gt;L'analyse par LLM est facultative : sans clef d'API, ou en cas de panne reseau, l'assistant repond avec son moteur a regles. Le cas de base reste complet sans l'extension." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;fillColor=#fff8e1;strokeColor=#fab219;fontSize=11;spacingLeft=6;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="1250" y="760" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="n106" value="&amp;laquo;include&amp;raquo; obligatoire&lt;br&gt;&lt;br&gt;Toute attribution declenche le controle des regles : une fois par an, une fois par carriere, ou rotation equitable selon le service." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;fillColor=#e9f7e9;strokeColor=#1baf7a;fontSize=11;spacingLeft=6;spacingTop=2;" vertex="1" parent="1">
